# ============================================================================
# AskMyDocs configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Application metadata database (PostgreSQL) ---
# See docker-compose.yml for matching credentials.
DATABASE_URL=postgresql+psycopg://askmydocs:askmydocs@localhost:5432/askmydocs

# --- Qdrant (vector search) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=askmydocs_chunks
QDRANT_DISTANCE=COSINE

# --- OpenSearch (BM25 full-text search) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=askmydocs_chunks

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# --- Re-ranker (cross-encoder) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=true
RERANK_TOP_K=8

# --- Chunking ---
CHUNK_STRATEGY=paragraph
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
BM25_TOP_K=20
VECTOR_TOP_K=20
HYBRID_TOP_K=20
RRF_K=60
FINAL_CONTEXT_K=5
MAX_CONTEXT_TOKENS=3000

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Grounding / answers ---
MAX_ANSWER_TOKENS=400
CONFIDENCE_THRESHOLD=0.5

# --- Observability (Langfuse) - leave empty to disable ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_PREFIX=askmydocs/

# --- Evaluation ---
EVAL_DATASET_PATH=evals/dataset/golden.jsonl
EVAL_RERANK_ENABLED=true