# ============================================================================
# AskMyDocs configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated CORS origins. Keep "*" locally; in production set your
# frontend domain, e.g. CORS_ORIGINS=https://askmydocs.vercel.app
CORS_ORIGINS=*

# --- Application metadata database (PostgreSQL) ---
# See docker-compose.yml for matching credentials.
DATABASE_URL=postgresql+psycopg://askmydocs:askmydocs@localhost:5432/askmydocs

# --- Qdrant (vector search) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=askmydocs_chunks
QDRANT_DISTANCE=COSINE

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64
WARMUP_MODELS=true

# --- Re-ranker (cross-encoder) ---
# Multilingual MiniLM cross-encoder (~118M). ~20x faster on CPU than
# BAAI/bge-reranker-v2-m3 (568M); swap back for maximum accuracy.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ENABLE_RERANKER=true
RERANK_TOP_K=8

# --- Chunking ---
CHUNK_STRATEGY=paragraph
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Uploads ---
# Where documents uploaded through POST /documents/upload are persisted.
UPLOAD_DIR=data/uploads

# --- Retrieval ---
BM25_TOP_K=20
VECTOR_TOP_K=20
HYBRID_TOP_K=20
RRF_K=60
FINAL_CONTEXT_K=5
MAX_CONTEXT_TOKENS=3000

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
# gpt-4o-mini: fast (~5s incl. retrieval+grounding), reliable, no hidden
# reasoning tokens. Costs roughly $0.001 per query.
# Reasoning models (e.g. nvidia/nemotron-3.5-lightning:free or
# nex-agi/nex-n2.5-mini:free) spend ~1000+ tokens on hidden reasoning, which
# doubles latency; if you switch to one, raise MAX_ANSWER_TOKENS to ~4096.
# Fastest free model measured (median 1.6s, 3/3 valid JSON + citations).
# Reasoning models emit hidden reasoning tokens, so MAX_ANSWER_TOKENS must stay high.
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true
# Reasoning effort for reasoning models (high|medium|low|none), sent as
# OpenRouter's `reasoning.effort`. Lower is faster (reasoning tokens dominate
# generation latency) but may hurt quality. Measured 2026-09: medium ≈23%
# faster than high with equal quality on a 2-question sample — too thin to
# flip the default; re-run a high-vs-medium comparison before lowering in prod.
LLM_REASONING_EFFORT=high

# --- Grounding / answers ---
MAX_ANSWER_TOKENS=8192
CONFIDENCE_THRESHOLD=0.5

# --- Observability (Langfuse) - leave empty to disable ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_PREFIX=askmydocs/

# --- Evaluation ---
EVAL_DATASET_PATH=evals/dataset/golden.jsonl
EVAL_RERANK_ENABLED=true

# --- Celery / Redis --------------------------------------------------------
# Local dev uses localhost. The production compose file
# (docker-compose.prod.yml) overrides these with redis://redis:6379/...,
# so leave these as-is; only the server's .env secrets matter.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Production (docker-compose.prod.yml only) -------------------------------
# Public DNS name of the API for Caddy HTTPS (e.g. api.example.com).
# Must resolve to the VM's public IP. Leave empty for local dev.
API_DOMAIN=
# Postgres credentials (must match between fresh volumes and .env).
POSTGRES_USER=askmydocs
POSTGRES_PASSWORD=askmydocs
POSTGRES_DB=askmydocs
# (Removed: OpenSearch heap — keyword search moved to Postgres tsvector.)
# HuggingFace model cache (2 GB+ of weights). Persisted on a Docker volume
# in prod; defaults to ~/.cache/huggingface locally.
HF_HOME=
